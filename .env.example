# Copy to .env and edit as needed. Noor runs fully offline with NO keys
# (LLM_PROVIDER=none); a key is only needed for synthesised answers.

# Generation provider: openai | none
LLM_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Models (multilingual, open-source) - defaults are good
# EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
# USE_RERANKER=true

# Retrieval / chunking (sensible defaults exist)
# CHUNK_SIZE=700
# CHUNK_OVERLAP=120
# DENSE_K=10
# LEXICAL_K=10
# TOP_K=4
